# Copy to .env (used by docker compose). Every value is optional for local development.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=agritech
# Must be at least 32 characters. Use a long random value for anything real.
APP_JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# Optional AI overlay. Keep the same model tag in Spring, LangChain and Ollama.
AI_MODEL=qwen2.5:0.5b
AI_LANGSMITH_TRACING=false
LANGSMITH_PROJECT=agritech-graph
# Set privately to send payload-redacted graph spans. Never commit a real key.
# LANGSMITH_API_KEY=
# LANGSMITH_WORKSPACE_ID=your-workspace-id
# AI_BACKEND_URL=http://localhost:8080
# Set FRONTEND_PORT=3001 when the original project's Node API uses port 3000.
# FRONTEND_PORT=3001
# API_PORT=8080
# POSTGRES_PORT=5432
# For IDE development outside Docker:
# OLLAMA_BASE_URL=http://localhost:11434
# AI_LANGCHAIN_URL=http://localhost:8001

# ---------------------------------------------------------------- platform modules
# Demo data: creates demo accounts (password Demo@2026) and sample listings, plans and deadlines.
# Use for local demos only; never in production.
APP_DEMO_SEED=false
# Shows the password-reset link on screen when no email/SMS is configured (local testing only).
APP_DEV_SHOW_RESET_LINK=false
# First administrator (created on start-up if no admin exists). Leave blank to skip.
# APP_ADMIN_CONTACT=0700000000
# APP_ADMIN_PASSWORD=choose-a-strong-password-1
# Document vault encryption key: 32 random bytes, base64 (openssl rand -base64 32).
# If blank, a key is derived from APP_JWT_SECRET (fine locally; set a separate key in production
# and keep it safe - documents cannot be decrypted without it).
# APP_VAULT_KEY=
# Email notifications and password resets (any SMTP provider)
# SPRING_MAIL_HOST=smtp.example.com
# SPRING_MAIL_PORT=587
# SPRING_MAIL_USERNAME=
# SPRING_MAIL_PASSWORD=
# APP_MAIL_FROM=no-reply@your-domain.co.za
# SMS via Africa's Talking (optional)
# AFRICASTALKING_USERNAME=
# AFRICASTALKING_API_KEY=
# WhatsApp Cloud API (optional)
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# VAT registration threshold used by the Business Builder rules (rand per 12 months)
# APP_VAT_THRESHOLD=1000000
# Use the local Ollama model as a fallback categoriser for unclear bank transactions
# APP_STATEMENTS_AI=false
# Daily check of official export-requirement pages for changes (results wait for human review)
# APP_EXPORT_MONITOR_ENABLED=false
# Optional trusted marketplace producer credential for completed produce-order analytics.
# Leave unset to disable internal ingestion. Never put this credential in browser code.
# SEGMENTATION_EVENT_TOKEN=
