# Copy to .env (used by docker compose). Every value is optional for local development.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=agritech
# Must be at least 32 characters. Use a long random value for anything real.
APP_JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# Optional AI overlay. Keep the same model tag in Spring, LangChain and Ollama.
AI_MODEL=qwen2.5:0.5b
AI_LANGSMITH_TRACING=false
LANGSMITH_PROJECT=agritech-graph
# Set privately to send payload-redacted graph spans. Never commit a real key.
# LANGSMITH_API_KEY=
# AI_BACKEND_URL=http://localhost:8080
# Set FRONTEND_PORT=3001 when the original project's Node API uses port 3000.
# FRONTEND_PORT=3001
# API_PORT=8080
# POSTGRES_PORT=5432
# For IDE development outside Docker:
# OLLAMA_BASE_URL=http://localhost:11434
# AI_LANGCHAIN_URL=http://localhost:8001
